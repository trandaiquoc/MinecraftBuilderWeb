{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://minecraftbuilder.app/schemas/minecraftbuilder-structure-v1.schema.json",
  "title": "MinecraftBuilder Structure JSON v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "minecraftVersion", "blocks"],
  "properties": {
    "format": { "const": "minecraftbuilder-structure" },
    "formatVersion": { "const": 1 },
    "minecraftVersion": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "z"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "state": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "propertyNames": { "pattern": "^[a-z0-9_.-]+$" }
        }
      }
    }
  }
}

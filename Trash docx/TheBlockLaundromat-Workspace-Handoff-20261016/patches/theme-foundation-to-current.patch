+              class="menu-popover camera-popover"
+              role="menu"
+              animate.enter="workspace-popover-enter"
+              animate.leave="workspace-popover-exit"
+            >
+              @for (preset of cameraPresets; track preset) {
+                <button
+                  type="button"
+                  role="menuitem"
+                  (click)="emit({ type: 'camera-preset', preset })"
+                >
+                  {{ cameraPresetLabel(preset) }}
+                </button>
+              }
+              <hr />
+              <button type="button" role="menuitem" (click)="emit({ type: 'reset-camera' })">
+                <svg lucideRotateCcw aria-hidden="true"></svg>
+                {{ i18n.t('resetCamera') }}
+              </button>
+            </div>
+          }
+        </div>
+      </div>
+    </div>
+  }
+</header>

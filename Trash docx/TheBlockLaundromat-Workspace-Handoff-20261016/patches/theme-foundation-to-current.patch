+    const camera = new THREE.PerspectiveCamera();
+    const grass = texture();
+    const fallback = vi.fn();
+    const owner = new RealityEnvironmentOwner(scene, camera, {
+      loadTexture: vi.fn(async () => grass),
+      scheduleRender: vi.fn(),
+      onFallback: fallback,
+    });

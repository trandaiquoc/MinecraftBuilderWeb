+          <svg lucideX aria-hidden="true"></svg>
+        </button>
+      </header>
+      <div class="move-offsets" [attr.aria-label]="i18n.t('moveGroup')">
+        <label
+          >X
+          <input
+            type="number"
+            step="1"
+            [value]="groups.moveOffset().x"
+            (input)="setOffset('x', $event)"
+        /></label>
+        <label
+          >Y
+          <input
+            type="number"
+            step="1"
+            [value]="groups.moveOffset().y"
+            (input)="setOffset('y', $event)"
+        /></label>
+        <label
+          >Z
+          <input
+            type="number"
+            step="1"
+            [value]="groups.moveOffset().z"
+            (input)="setOffset('z', $event)"
+        /></label>
+      </div>
+      <label class="move-step-label"
+        >{{ i18n.t('moveStep') }}
+        <input type="number" min="1" step="1" [value]="groups.moveStep()" (input)="setStep($event)"
+      /></label>
+      <div class="nudge-grid" [attr.aria-label]="i18n.t('moveGroup')">
+        <button
+          type="button"
+          [attr.aria-label]="i18n.t('axisZMinus')"
+          (click)="groups.nudgeMove('z', -1)"
+        >
+          {{ i18n.t('axisZMinus') }}
+        </button>
+        <button
+          type="button"
+          [attr.aria-label]="i18n.t('axisXMinus')"
+          (click)="groups.nudgeMove('x', -1)"
+        >
+          {{ i18n.t('axisXMinus') }}
+        </button>
+        <button
+          type="button"
+          uiTooltip="{{ i18n.t('resetOffsets') }}"
+          [attr.aria-label]="i18n.t('resetOffsets')"
+          (click)="groups.resetMove()"
+        >
+          <svg lucideRotateCcw aria-hidden="true"></svg>
+        </button>
+        <button
+          type="button"
+          [attr.aria-label]="i18n.t('axisXPlus')"
+          (click)="groups.nudgeMove('x', 1)"
+        >
+          {{ i18n.t('axisXPlus') }}
+        </button>
+        <button
+          type="button"
+          [attr.aria-label]="i18n.t('axisZPlus')"
+          (click)="groups.nudgeMove('z', 1)"
+        >
+          {{ i18n.t('axisZPlus') }}
+        </button>
+      </div>
+      <div class="height-buttons">
+        <button
+          type="button"
+          [attr.aria-label]="i18n.t('axisYMinus')"
+          (click)="groups.nudgeMove('y', -1)"
+        >
+          {{ i18n.t('axisYMinus') }}
+        </button>
+        <button
+          type="button"
+          [attr.aria-label]="i18n.t('axisYPlus')"
+          (click)="groups.nudgeMove('y', 1)"
+        >
+          {{ i18n.t('axisYPlus') }}
+        </button>
+      </div>
+      @if (moveReason()) {
+        <p class="move-error" role="status">{{ moveReason() }}</p>
+      }
+      <div class="move-actions">
+        <button
+          type="button"
+          class="ui-button ui-button--primary ui-button--sm"
+          [disabled]="
+            !groups.movePreview()?.valid ||
+            (!groups.moveOffset().x && !groups.moveOffset().y && !groups.moveOffset().z)
+          "
+          (click)="saveMove()"
+        >
+          {{ i18n.t('saveMove') }}
+        </button>
+        <button
+          type="button"
+          class="ui-button ui-button--secondary ui-button--sm"
+          (click)="close()"
+        >
+          {{ i18n.t('cancelMove') }}
+        </button>
+      </div>
+    </section>
+  }
+}

+    resolveSelected(selectedTexture);
+    await flushTextureTasks();
+    resolveStale(staleTexture);
+    await flushTextureTasks();
+
+    const ground = scene.getObjectByName('realityGround') as THREE.Mesh<
+      THREE.PlaneGeometry,
+      THREE.MeshBasicMaterial

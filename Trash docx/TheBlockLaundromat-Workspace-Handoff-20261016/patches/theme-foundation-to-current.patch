+    expect(selectedLoads).toBe(2);
+    expect(ground.visible).toBe(true);
+    expect(ground.material.map).toBe(selectedTexture);
+    expect(staleDispose).toHaveBeenCalledTimes(1);
+    expect(onFallback).not.toHaveBeenCalled();
+    owner.dispose();
